2782 133.101 3.50446 132.773 3.50446C131.839 3.50446 131.138 3.73809 130.671 4.20534C130.227 4.64923 130.005 5.30338 130.005 6.16779V25.582H125.589ZM122.365 11.179V7.70971H133.895V11.179H122.365ZM140.812 25.9325C139.573 25.9325 138.499 25.6755 137.588 25.1615C136.7 24.6242 136.011 23.8999 135.52 22.9888C135.053 22.0777 134.819 21.0497 134.819 19.9049V7.70971H139.235V18.9938C139.235 20.0918 139.503 20.9212 140.041 21.4819C140.601 22.0426 141.384 22.323 142.389 22.323C143.3 22.323 144.094 22.1127 144.772 21.6922C145.472 21.2716 146.021 20.6876 146.419 19.94C146.839 19.169 147.049 18.3046 147.049 17.3467L147.505 21.6221C146.921 22.9304 146.045 23.9817 144.877 24.776C143.732 25.547 142.377 25.9325 140.812 25.9325ZM147.19 25.582V21.3768H147.049V7.70971H151.5V25.582H147.19ZM154.427 25.582V0.350524H158.842V25.582H154.427Z\" fill=\"currentColor\"/></svg>\n    </span>\n    <div style=\"display:flex;align-items:center;gap:20px;\" data-el=\"top-bar-right\">\n      <span style=\"font-size:13px;font-weight:600;opacity:0.5;\">Step 2 of 4 — Provider Availability Settings</span>\n      <span class=\"avatar\" data-size=\"sm\"><img src=\"https://richardcollins-pixel.github.io/thoughtful-design-system/tds/assets/images/therapists/Therapist-7.png\" alt=\"Kristina\"></span>\n    </div>\n  </div>\n\n  <!-- Body: sidebar + main -->\n  <div style=\"flex:1;display:flex;max-width:1280px;width:100%;margin:0 auto;padding:0 48px;\" data-el=\"main-layout\">\n\n    <!-- Left sidebar: checklist + section nav -->\n    <div style=\"width:280px;flex-shrink:0;padding:48px 40px 48px 0;border-right:1px solid rgba(255,255,255,0.08);display:flex;flex-direction:column;\" data-el=\"checklist-sidebar\">\n\n      <p style=\"font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;opacity:0.4;margin:0 0 24px;\" data-el=\"sidebar-label\">Your setup</p>\n\n      <!-- Step 1: Complete -->\n      <div data-el=\"sidebar-step-1\" style=\"display:flex;gap:14px;align-items:flex-start;margin-bottom:4px;\">\n        <div style=\"display:flex;flex-direction:column;align-items:center;flex-shrink:0;\">\n          <div style=\"width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:rgba(255,255,255,0.85);\">\n            <i class=\"icon icon-check\" style=\"font-size:13px;color:#1a1025;\"></i>\n          </div>\n          <div style=\"width:1px;height:48px;background:rgba(255,255,255,0.15);margin-top:4px;\"></div>\n        </div>\n        <div style=\"padding-top:4px;\">\n          <p style=\"font-size:14px;font-weight:600;margin:0 0 3px;opacity:0.7;\">Provider Onboarding Form</p>\n          <p style=\"font-size:12px;opacity:0.45;margin:0;line-height:1.5;\">Submitted — in review</p>\n        </div>\n      </div>\n\n      <!-- Step 2: Active -->\n      <div data-el=\"sidebar-step-2\" style=\"display:flex;gap:14px;align-items:flex-start;margin-bottom:4px;\">\n        <div style=\"display:flex;flex-direction:column;align-items:center;flex-shrink:0;\">\n          <div style=\"width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;background:rgba(255,255,255,1);color:#1a1025;\">2</div>\n          <div style=\"width:1px;height:48px;background:rgba(255,255,255,0.12);margin-top:4px;\"></div>\n        </div>\n        <div style=\"padding-top:4px;\">\n          <p style=\"font-size:14px;font-weight:700;margin:0 0 3px;\">Availability Settings</p>\n          <p style=\"font-size:12px;opacity:0.55;margin:0;line-height:1.5;\">Connect Gmail &amp; set weekly hours</p>\n        </div>\n      </div>\n\n      <!-- Step 3: Locked -->\n      <div data-el=\"sidebar-step-3\" style=\"display:flex;gap:14px;align-items:flex-start;margin-bottom:4px;opacity:0.35;\">\n        <div style=\"display:flex;flex-direction:column;align-items:center;flex-shrink:0;\">\n          <div style=\"width:28px;height:28px;border-radius:50%;border:1px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;\">3</div>\n          <div style=\"width:1px;height:48px;background:rgba(255,255,255,0.08);margin-top:4px;\"></div>\n        </div>\n        <div style=\"padding-top:4px;\">\n          <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:3px;\">\n            <p style=\"font-size:14px;font-weight:600;margin:0;\">Training</p>\n            <i class=\"icon icon-lock\" style=\"font-size:12px;opacity:0.6;\"></i>\n          </div>\n          <p style=\"font-size:12px;opacity:0.6;margin:0;line-height:1.5;\">Complete materials &amp; mark done</p>\n        </div>\n      </div>\n\n      <!-- Step 4: Locked -->\n      <div data-el=\"sidebar-step-4\" style=\"display:flex;gap:14px;align-items:flex-start;opacity:0.35;\">\n        <div style=\"display:flex;flex-direction:column;align-items:center;flex-shrink:0;\">\n          <div style=\"width:28px;height:28px;border-radius:50%;border:1px solid rgba(255,255,255,0.3);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;\">4</div>\n        </div>\n        <div style=\"padding-top:4px;\">\n          <div style=\"display:flex;align-items:center;gap:6px;margin-bottom:3px;\">\n            <p style=\"font-size:14px;font-weight:600;margin:0;\">Practice Appointment &amp; Go-Live</p>\n            <i class=\"icon icon-lock\" style=\"font-size:12px;opacity:0.6;\"></i>\n          </div>\n          <p style=\"font-size:12px;opacity:0.6;margin:0;line-height:1.5;\">Final session &amp; First Bookable Date</p>\n        </div>\n      </div>\n\n      <!-- Section navigation within step 2 -->\n      <div style=\"margin-top:40px;\" data-el=\"section-nav\">\n        <p style=\"font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;opacity:0.4;margin:0 0 12px;\">This step</p>\n        <div style=\"display:flex;flex-direction:column;gap:2px;\">\n          <div style=\"padding:8px 12px;border-radius:8px;background:rgba(255,255,255,0.1);\" data-el=\"section-nav-calendars\">\n            <span style=\"font-size:13px;font-weight:600;\">1. Connected calendars</span>\n          </div>\n          <div style=\"padding:8px 12px;border-radius:8px;opacity:0.55;\" data-el=\"section-nav-hours\">\n            <span style=\"font-size:13px;\">2. Weekly hours</span>\n          </div>\n          <div style=\"padding:8px 12px;border-radius:8px;opacity:0.55;\" data-el=\"section-nav-overrides\">\n            <span style=\"font-size:13px;\">3. Date overrides</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Glow -->\n      <div style=\"margin-top:auto;padding-top:48px;pointer-events:none;opacity:0.5;\" data-el=\"sidebar-glow\">\n        <div class=\"glow\" data-theme=\"warm\" data-cycle=\"on\" style=\"--glow-size:180px;--glow-blur:56px;\">\n          <canvas aria-hidden=\"true\"></canvas>\n        </div>\n      </div>\n    </div>\n\n    <!-- Main: availability form -->\n    <div style=\"flex:1;padding:48px 0 80px 52px;max-width:760px;\" data-el=\"main-content\">\n\n      <!-- Page header -->\n      <div style=\"margin-bottom:40px;\" data-el=\"page-header\">\n        <div style=\"display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;\">\n          <p style=\"font-size:12px;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;opacity:0.45;margin:0;\">Step 2 of 4</p>\n          <div style=\"display:flex;align-items:center;gap:10px;\" data-el=\"progress-indicator\">\n            <div style=\"width:160px;height:4px;border-radius:4px;background:rgba(255,255,255,0.1);overflow:hidden;\">\n              <div style=\"width:25%;height:100%;background:rgba(255,255,255,0.75);border-radius:4px;\"></div>\n            </div>\n            <span style=\"font-size:12px;opacity:0.5;\">1 of 4 complete</span>\n          </div>\n        </div>\n        <h1 style=\"font-size:28px;font-weight:700;line-height:1.2;margin:0 0 10px;\" data-el=\"page-headline\">Provider Availability Settings</h1>\n        <p style=\"font-size:15px;opacity:0.6;margin:0;line-height:1.6;\" data-el=\"page-intro\">Connect your Gmail calendars so bookings check all of them for conflicts, then set your recurring weekly hours. Cal.com runs behind the scenes — you won't need to go there.</p>\n      </div>\n\n      <!-- ── Section 1: Gmail Calendars ── -->\n      <div style=\"margin-bottom:48px;\" data-el=\"section-calendars\">\n\n        <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:6px;\" data-el=\"section-calendars-heading\">\n          <div style=\"width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,0.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n            <span style=\"font-size:11px;font-weight:800;\">1</span>\n          </div>\n          <h2 style=\"font-size:18px;font-weight:700;margin:0;\">Connected calendars</h2>\n        </div>\n        <p style=\"font-size:14px;opacity:0.6;margin:0 0 20px;line-height:1.6;padding-left:32px;\" data-el=\"section-calendars-copy\">Connect one or more Gmail calendars. When a member books you, every connected calendar is checked for conflicts so you're never double-booked. Only Gmail is supported.</p>\n\n        <!-- Gmail-only notice -->\n        <div style=\"margin-bottom:20px;padding:14px 16px;border-radius:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);display:flex;gap:10px;align-items:flex-start;\" data-el=\"gmail-only-notice\">\n          <i class=\"icon icon-warning\" style=\"opacity:0.6;font-size:15px;margin-top:1px;flex-shrink:0;\"></i>\n          <p style=\"font-size:13px;opacity:0.65;margin:0;line-height:1.5;\"><span style=\"font-weight:700;opacity:1;\">Only Gmail calendars are supported.</span> If your primary calendar is Outlook, Apple Calendar or another provider, you'll need to set up a Gmail account to use as your booking calendar before continuing.</p>\n        </div>\n\n        <!-- Connected calendar rows -->\n        <div style=\"display:flex;flex-direction:column;gap:10px;margin-bottom:16px;\" data-el=\"calendar-list\">\n\n          <!-- Calendar 1: Connected -->\n          <div class=\"card\" data-fill=\"flat\" data-el=\"calendar-row-1\" style=\"display:flex;align-items:center;gap:14px;padding:16px 18px;border:1px solid rgba(255,255,255,0.12);\">\n            <!-- Google G mark -->\n            <div style=\"width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;\" data-el=\"calendar-1-icon\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\"><path d=\"M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z\" fill=\"rgba(255,255,255,0.7)\"/><path d=\"M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z\" fill=\"rgba(255,255,255,0.55)\"/><path d=\"M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z\" fill=\"rgba(255,255,255,0.4)\"/><path d=\"M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z\" fill=\"rgba(255,255,255,0.65)\"/></svg>\n            </div>\n            <div style=\"flex:1;\" data-el=\"calendar-1-info\">\n              <p style=\"font-size:14px;font-weight:700;margin:0 0 2px;\">kristina@gmail.com</p>\n              <p style=\"font-size:12px;opacity:0.5;margin:0;\">Primary · Conflict checks on</p>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:10px;\" data-el=\"calendar-1-actions\">\n              <span style=\"font-size:12px;font-weight:600;padding:4px 10px;border-radius:20px;background:rgba(255,255,255,0.12);opacity:0.9;\">Connected</span>\n              <button class=\"icon-button\" data-elevation=\"20\" data-size=\"sm\" aria-label=\"Remove kristina@gmail.com\">\n                <i class=\"icon icon-x\"></i>\n              </button>\n            </div>\n          </div>\n\n          <!-- Calendar 2: Connected -->\n          <div class=\"card\" data-fill=\"flat\" data-el=\"calendar-row-2\" style=\"display:flex;align-items:center;gap:14px;padding:16px 18px;border:1px solid rgba(255,255,255,0.12);\">\n            <div style=\"width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;\" data-el=\"calendar-2-icon\">\n              <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" aria-hidden=\"true\"><path d=\"M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z\" fill=\"rgba(255,255,255,0.7)\"/><path d=\"M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z\" fill=\"rgba(255,255,255,0.55)\"/><path d=\"M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z\" fill=\"rgba(255,255,255,0.4)\"/><path d=\"M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z\" fill=\"rgba(255,255,255,0.65)\"/></svg>\n            </div>\n            <div style=\"flex:1;\" data-el=\"calendar-2-info\">\n              <p style=\"font-size:14px;font-weight:700;margin:0 0 2px;\">kristina.work@gmail.com</p>\n              <p style=\"font-size:12px;opacity:0.5;margin:0;\">Secondary · Conflict checks on</p>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:10px;\" data-el=\"calendar-2-actions\">\n              <span style=\"font-size:12px;font-weight:600;padding:4px 10px;border-radius:20px;background:rgba(255,255,255,0.12);opacity:0.9;\">Connected</span>\n              <button class=\"icon-button\" data-elevation=\"20\" data-size=\"sm\" aria-label=\"Remove kristina.work@gmail.com\">\n                <i class=\"icon icon-x\"></i>\n              </button>\n            </div>\n          </div>\n\n          <!-- Non-Gmail block: attempted Outlook -->\n          <div class=\"card\" data-fill=\"flat\" data-el=\"calendar-row-blocked\" style=\"display:flex;align-items:center;gap:14px;padding:16px 18px;border:1px solid rgba(220,80,80,0.4);background:rgba(220,80,80,0.07);\">\n            <div style=\"width:36px;height:36px;border-radius:50%;background:rgba(220,80,80,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;\" data-el=\"calendar-blocked-icon\">\n              <i class=\"icon icon-x\" style=\"font-size:16px;opacity:0.7;\"></i>\n            </div>\n            <div style=\"flex:1;\" data-el=\"calendar-blocked-info\">\n              <p style=\"font-size:14px;font-weight:700;margin:0 0 2px;\">kristina@outlook.com</p>\n              <p style=\"font-size:12px;opacity:0.65;margin:0;\">Outlook calendar — not supported</p>\n            </div>\n            <div data-el=\"calendar-blocked-badge\">\n              <span style=\"font-size:12px;font-weight:600;padding:4px 10px;border-radius:20px;background:rgba(220,80,80,0.2);opacity:1;\">Can't connect</span>\n            </div>\n          </div>\n\n          <!-- Non-Gmail block explanation -->\n          <div style=\"padding:14px 16px;border-radius:10px;background:rgba(220,80,80,0.08);border:1px solid rgba(220,80,80,0.25);display:flex;gap:10px;align-items:flex-start;\" data-el=\"non-gmail-block\">\n            <i class=\"icon icon-warning\" style=\"font-size:15px;opacity:0.7;margin-top:1px;flex-shrink:0;\"></i>\n            <div>\n              <p style=\"font-size:13px;font-weight:700;margin:0 0 4px;\">Only Gmail calendars can be connected</p>\n              <p style=\"font-size:13px;opacity:0.65;margin:0;line-height:1.5;\">Outlook, Apple Calendar and other providers aren't supported. To use a non-Gmail calendar for conflict checks, <span style=\"font-weight:700;opacity:1;\">create a Gmail account</span> and forward your events there, then connect that Gmail account instead.</p>\n            </div>\n          </div>\n        </div>\n\n        <!-- Add another Gmail -->\n        <button class=\"button\" data-variant=\"outline\" data-size=\"md\" data-el=\"add-calendar-cta\">\n          Connect another Gmail calendar\n        </button>\n      </div>\n\n      <!-- ── Section 2: Weekly Hours ── -->\n      <div style=\"margin-bottom:48px;\" data-el=\"section-weekly-hours\">\n\n        <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:6px;\" data-el=\"section-hours-heading\">\n          <div style=\"width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,0.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n            <span style=\"font-size:11px;font-weight:800;\">2</span>\n          </div>\n          <h2 style=\"font-size:18px;font-weight:700;margin:0;\">Recurring weekly hours</h2>\n        </div>\n        <p style=\"font-size:14px;opacity:0.6;margin:0 0 20px;line-height:1.6;padding-left:32px;\" data-el=\"section-hours-copy\">Set the days and times you're available each week. These become your recurring slots. You can add date overrides below for specific days off or changed hours.</p>\n\n        <!-- Day rows -->\n        <div style=\"display:flex;flex-direction:column;gap:6px;\" data-el=\"weekly-hours-grid\">\n\n          <!-- Mon -->\n          <div style=\"display:flex;align-items:center;gap:16px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"hours-row-mon\">\n            <div style=\"width:100px;flex-shrink:0;display:flex;align-items:center;gap:10px;\">\n              <button class=\"toggle\" role=\"switch\" aria-checked=\"true\" data-on=\"true\"><span></span></button>\n              <span style=\"font-size:13px;font-weight:700;\">Mon</span>\n            </div>\n            <div style=\"flex:1;display:flex;align-items:center;gap:10px;\" data-el=\"hours-row-mon-times\">\n              <div class=\"text-field\" data-filled=\"yes\" data-focused=\"no\" data-error=\"no\" style=\"width:100px;\">\n                <span class=\"text-field__text\">9:00 AM</span>\n              </div>\n              <span style=\"font-size:13px;opacity:0.5;\">to</span>\n              <div class=\"text-field\" data-filled=\"yes\" data-focused=\"no\" data-error=\"no\" style=\"width:100px;\">\n                <span class=\"text-field__text\">5:00 PM</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Tue -->\n          <div style=\"display:flex;align-items:center;gap:16px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"hours-row-tue\">\n            <div style=\"width:100px;flex-shrink:0;display:flex;align-items:center;gap:10px;\">\n              <button class=\"toggle\" role=\"switch\" aria-checked=\"true\" data-on=\"true\"><span></span></button>\n              <span style=\"font-size:13px;font-weight:700;\">Tue</span>\n            </div>\n            <div style=\"flex:1;display:flex;align-items:center;gap:10px;\" data-el=\"hours-row-tue-times\">\n              <div class=\"text-field\" data-filled=\"yes\" data-focused=\"no\" data-error=\"no\" style=\"width:100px;\">\n                <span class=\"text-field__text\">9:00 AM</span>\n              </div>\n              <span style=\"font-size:13px;opacity:0.5;\">to</span>\n              <div class=\"text-field\" data-filled=\"yes\" data-focused=\"no\" data-error=\"no\" style=\"width:100px;\">\n                <span class=\"text-field__text\">5:00 PM</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Wed -->\n          <div style=\"display:flex;align-items:center;gap:16px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"hours-row-wed\">\n            <div style=\"width:100px;flex-shrink:0;display:flex;align-items:center;gap:10px;\">\n              <button class=\"toggle\" role=\"switch\" aria-checked=\"true\" data-on=\"true\"><span></span></button>\n              <span style=\"font-size:13px;font-weight:700;\">Wed</span>\n            </div>\n            <div style=\"flex:1;display:flex;align-items:center;gap:10px;\" data-el=\"hours-row-wed-times\">\n              <div class=\"text-field\" data-filled=\"yes\" data-focused=\"no\" data-error=\"no\" style=\"width:100px;\">\n                <span class=\"text-field__text\">10:00 AM</span>\n              </div>\n              <span style=\"font-size:13px;opacity:0.5;\">to</span>\n              <div class=\"text-field\" data-filled=\"yes\" data-focused=\"no\" data-error=\"no\" style=\"width:100px;\">\n                <span class=\"text-field__text\">3:00 PM</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Thu -->\n          <div style=\"display:flex;align-items:center;gap:16px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"hours-row-thu\">\n            <div style=\"width:100px;flex-shrink:0;display:flex;align-items:center;gap:10px;\">\n              <button class=\"toggle\" role=\"switch\" aria-checked=\"true\" data-on=\"true\"><span></span></button>\n              <span style=\"font-size:13px;font-weight:700;\">Thu</span>\n            </div>\n            <div style=\"flex:1;display:flex;align-items:center;gap:10px;\" data-el=\"hours-row-thu-times\">\n              <div class=\"text-field\" data-filled=\"yes\" data-focused=\"no\" data-error=\"no\" style=\"width:100px;\">\n                <span class=\"text-field__text\">9:00 AM</span>\n              </div>\n              <span style=\"font-size:13px;opacity:0.5;\">to</span>\n              <div class=\"text-field\" data-filled=\"yes\" data-focused=\"no\" data-error=\"no\" style=\"width:100px;\">\n                <span class=\"text-field__text\">5:00 PM</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Fri -->\n          <div style=\"display:flex;align-items:center;gap:16px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"hours-row-fri\">\n            <div style=\"width:100px;flex-shrink:0;display:flex;align-items:center;gap:10px;\">\n              <button class=\"toggle\" role=\"switch\" aria-checked=\"false\" data-on=\"false\"><span></span></button>\n              <span style=\"font-size:13px;font-weight:700;opacity:0.4;\">Fri</span>\n            </div>\n            <div style=\"flex:1;\" data-el=\"hours-row-fri-off\">\n              <span style=\"font-size:13px;opacity:0.35;\">Not available</span>\n            </div>\n          </div>\n\n          <!-- Sat -->\n          <div style=\"display:flex;align-items:center;gap:16px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"hours-row-sat\">\n            <div style=\"width:100px;flex-shrink:0;display:flex;align-items:center;gap:10px;\">\n              <button class=\"toggle\" role=\"switch\" aria-checked=\"false\" data-on=\"false\"><span></span></button>\n              <span style=\"font-size:13px;font-weight:700;opacity:0.4;\">Sat</span>\n            </div>\n            <div style=\"flex:1;\" data-el=\"hours-row-sat-off\">\n              <span style=\"font-size:13px;opacity:0.35;\">Not available</span>\n            </div>\n          </div>\n\n          <!-- Sun -->\n          <div style=\"display:flex;align-items:center;gap:16px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"hours-row-sun\">\n            <div style=\"width:100px;flex-shrink:0;display:flex;align-items:center;gap:10px;\">\n              <button class=\"toggle\" role=\"switch\" aria-checked=\"false\" data-on=\"false\"><span></span></button>\n              <span style=\"font-size:13px;font-weight:700;opacity:0.4;\">Sun</span>\n            </div>\n            <div style=\"flex:1;\" data-el=\"hours-row-sun-off\">\n              <span style=\"font-size:13px;opacity:0.35;\">Not available</span>\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- ── Section 3: Date Overrides ── -->\n      <div style=\"margin-bottom:56px;\" data-el=\"section-date-overrides\">\n\n        <div style=\"display:flex;align-items:center;gap:10px;margin-bottom:6px;\" data-el=\"section-overrides-heading\">\n          <div style=\"width:22px;height:22px;border-radius:50%;background:rgba(255,255,255,0.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;\">\n            <span style=\"font-size:11px;font-weight:800;\">3</span>\n          </div>\n          <h2 style=\"font-size:18px;font-weight:700;margin:0;\">Date overrides</h2>\n        </div>\n        <p style=\"font-size:14px;opacity:0.6;margin:0 0 20px;line-height:1.6;padding-left:32px;\" data-el=\"section-overrides-copy\">Add specific dates where your hours differ from your weekly schedule — days off, holidays or one-off availability changes.</p>\n\n        <!-- Existing overrides -->\n        <div style=\"display:flex;flex-direction:column;gap:8px;margin-bottom:16px;\" data-el=\"override-list\">\n\n          <!-- Override 1: day off -->\n          <div style=\"display:flex;align-items:center;gap:14px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"override-row-1\">\n            <div style=\"width:120px;flex-shrink:0;\" data-el=\"override-1-date\">\n              <p style=\"font-size:13px;font-weight:700;margin:0;\">Mon, Dec 23</p>\n              <p style=\"font-size:12px;opacity:0.5;margin:0;\">2024</p>\n            </div>\n            <div style=\"flex:1;\" data-el=\"override-1-detail\">\n              <span style=\"font-size:13px;padding:4px 10px;border-radius:20px;background:rgba(255,255,255,0.1);font-weight:600;\">Unavailable all day</span>\n            </div>\n            <button class=\"icon-button\" data-elevation=\"20\" data-size=\"sm\" aria-label=\"Remove Dec 23 override\">\n              <i class=\"icon icon-x\"></i>\n            </button>\n          </div>\n\n          <!-- Override 2: shortened hours -->\n          <div style=\"display:flex;align-items:center;gap:14px;padding:14px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);\" data-el=\"override-row-2\">\n            <div style=\"width:120px;flex-shrink:0;\" data-el=\"override-2-date\">\n              <p style=\"font-size:13px;font-weight:700;margin:0;\">Thu, Jan 2</p>\n              <p style=\"font-size:12px;opacity:0.5;margin:0;\">2025</p>\n            </div>\n            <div style=\"flex:1;\" data-el=\"override-2-detail\">\n              <span style=\"font-size:13px;padding:4px 10px;border-radius:20px;background:rgba(255,255,255,0.1);font-weight:600;\">9:00 AM – 12:00 PM only</span>\n            </div>\n            <button class=\"icon-button\" data-elevation=\"20\" data-size=\"sm\" aria-label=\"Remove Jan 2 override\">\n              <i class=\"icon icon-x\"></i>\n            </button>\n          </div>\n\n        </div>\n\n        <button class=\"button\" data-variant=\"outline\" data-size=\"md\" data-el=\"add-override-cta\">\n          Add a date override\n        </button>\n      </div>\n\n      <!-- Divider + save -->\n      <div style=\"padding-top:32px;border-top:1px solid rgba(255,255,255,0.1);\" data-el=\"form-footer\">\n        <div style=\"padding:16px 18px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);margin-bottom:24px;display:flex;gap:12px;align-items:flex-start;\" data-el=\"cal-com-note\">\n          <i class=\"icon icon-check\" style=\"opacity:0.55;font-size:15px;margin-top:1px;flex-shrink:0;\"></i>\n          <p style=\"font-size:13px;opacity:0.6;margin:0;line-height:1.5;\">Cal.com runs behind the scenes to manage your booking slots. You don't need to visit Cal.com — everything is managed here. Your availability is saved and synced automatically.</p>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:16px;\" data-el=\"form-actions\">\n          <button class=\"button\" data-variant=\"filled\" data-size=\"lg\" data-el=\"save-availability-cta\">Save availability and continue</button>\n          <button class=\"button\" data-variant=\"flat\" data-size=\"lg\" data-el=\"save-draft-cta\">Save draft</button>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>",
