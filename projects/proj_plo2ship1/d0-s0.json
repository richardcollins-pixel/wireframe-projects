  "html": "<div style=\"min-height:800px;background:#ececf0;padding:56px 24px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:flex-start;\"><div style=\"max-width:620px;margin:0 auto;background:#fff;border-radius:16px;padding:40px 44px;box-shadow:0 6px 24px rgba(0,0,0,0.06);\"><p style=\"font-size:12px;color:#8a8a92;margin:0 0 6px;\">From: Thoughtful</p><p style=\"font-size:12px;color:#8a8a92;margin:0 0 28px;\">Subject: You&#39;re invited to join Thoughtful as a provider</p><span style=\"font-size:20px;font-weight:800;letter-spacing:-0.02em;color:#111;\">thoughtful</span><h1 style=\"font-size:26px;line-height:1.2;color:#111;margin:28px 0 12px;\">Welcome, Sarah.</h1><p style=\"font-size:15px;line-height:1.6;color:#44444c;margin:0 0 20px;\">You&#39;re set up for Thoughtful. Here are four easy steps to get you ready for your first session.</p><div style=\"display:flex;gap:16px;padding:18px 0;border-bottom:1px solid #ececf0;\"><span style=\"flex:0 0 28px;height:28px;border-radius:999px;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;\">1</span><div style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-size:15px;font-weight:600;color:#111;\">Sign in to the Provider Portal</span><span style=\"font-size:14px;line-height:1.5;color:#55555e;\">Use the sign-in link below. We&#39;ll email you a magic link each time you sign in.</span><a href=\"#\" style=\"font-size:14px;font-weight:600;color:#111;text-decoration:underline;\">Open the Provider Portal</a></div></div><div style=\"display:flex;gap:16px;padding:18px 0;border-bottom:1px solid #ececf0;\"><span style=\"flex:0 0 28px;height:28px;border-radius:999px;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;\">2</span><div style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-size:15px;font-weight:600;color:#111;\">Finish your profile and calendars</span><span style=\"font-size:14px;line-height:1.5;color:#55555e;\">Add your details and connect your calendar so members can find you.</span><a href=\"#\" style=\"font-size:14px;font-weight:600;color:#111;text-decoration:underline;\">Go to the Provider Portal</a></div></div><div style=\"display:flex;gap:16px;padding:18px 0;border-bottom:1px solid #ececf0;\"><span style=\"flex:0 0 28px;height:28px;border-radius:999px;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;\">3</span><div style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-size:15px;font-weight:600;color:#111;\">Complete your training</span><span style=\"font-size:14px;line-height:1.5;color:#55555e;\">Work through the training at your own pace.</span><a href=\"#\" style=\"font-size:14px;font-weight:600;color:#111;text-decoration:underline;\">Open training</a></div></div><div style=\"display:flex;gap:16px;padding:18px 0;border-bottom:1px solid #ececf0;\"><span style=\"flex:0 0 28px;height:28px;border-radius:999px;background:#111;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;\">4</span><div style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-size:15px;font-weight:600;color:#111;\">Download the app and join Slack</span><span style=\"font-size:14px;line-height:1.5;color:#55555e;\">Try a few sessions with T, and say hi in the provider Slack group.</span><a href=\"#\" style=\"font-size:14px;font-weight:600;color:#111;text-decoration:underline;\">App Store &middot; Google Play &middot; Slack group</a></div></div><a href=\"#\" style=\"display:inline-block;margin-top:28px;background:#111;color:#fff;border-radius:999px;padding:14px 26px;font-size:15px;font-weight:600;text-decoration:none;\">Sign in to the Provider Portal</a><p style=\"font-size:12px;line-height:1.5;color:#8a8a92;margin:28px 0 0;\">Need help? Email providers@springhealth.com</p></div></div>"
