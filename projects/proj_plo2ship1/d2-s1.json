  "html": "<div style=\"min-height:800px;background:#f5f5f7;color:#111114;display:flex;flex-direction:column;\"><header style=\"background:#111114;color:white;padding:16px 28px;display:flex;justify-content:space-between;align-items:center;\"><span style=\"font-size:16px;font-weight:700;\">Admin Console</span><span style=\"font-size:13px;opacity:0.7;\">Providers &middot; Sarah Admin</span></header><div style=\"padding:28px;box-sizing:border-box;display:flex;flex-direction:column;gap:20px;\"><section style=\"background:#ffffff;border-radius:14px;padding:22px;box-sizing:border-box;max-width:620px;margin:40px auto 0;\"><h2 style=\"font-size:20px;margin:0 0 6px;\">Invite provider</h2><p style=\"font-size:14px;color:#6b6b74;margin:0 0 20px;\">This creates the provider&#39;s account, calendar account and member profile, then sends the invite.</p><div style=\"display:flex;flex-direction:column;gap:18px;\"><div style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-size:13px;font-weight:600;\">Name</span><div style=\"background:#f5f5f7;border-radius:10px;padding:12px 14px;font-size:14px;color:#111114;\">Sarah Chen</div><span style=\"font-size:12px;color:#6b6b74;\">As it should appear on the provider&#39;s account</span></div><div style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-size:13px;font-weight:600;\">Email</span><div style=\"background:#f5f5f7;border-radius:10px;padding:12px 14px;font-size:14px;color:#111114;\">sarah.chen@example.com</div><span style=\"font-size:12px;color:#6b6b74;\">Must be a Gmail address. This becomes their sign-in and default calendar.</span></div><div style=\"display:flex;flex-direction:column;gap:6px;\"><span style=\"font-size:13px;font-weight:600;\">Phone</span><div style=\"background:#f5f5f7;border-radius:10px;padding:12px 14px;font-size:14px;color:#111114;\">(555) 010-0101</div><span style=\"font-size:12px;color:#6b6b74;\">Used to create the provider&#39;s member profile. Not shown on their provider profile.</span></div></div><div style=\"display:flex;justify-content:flex-end;gap:10px;margin-top:24px;\"><span style=\"background:#ececf0;color:#111114;border-radius:10px;padding:10px 16px;font-size:13px;font-weight:600;white-space:nowrap;\">Cancel</span><span style=\"background:#111114;color:white;border-radius:10px;padding:10px 16px;font-size:13px;font-weight:600;white-space:nowrap;\">Create and send invite</span></div></section></div></div>"
